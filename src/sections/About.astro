---
import SectionHeading from '../components/astro/SectionHeading.astro';
import { education } from '../data/education';
import { profile } from '../data/profile';
---

<SectionHeading id="about" numeral="V" title="From the Editor’s Desk" kicker="Profile · Education · Working principles" />

<div class="about-grid">
  <figure>
    <img src={profile.portrait} width="640" height="800" alt="Portrait photograph of Naeem Ahsan" loading="lazy" />
  </figure>

  <div class="about-copy">
    <p class="about-statement">Hi, I’m Naeem.<br />I build full-stack web experiences.</p>
    <p class="prose-copy">{profile.biography}</p>
    <dl>
      <div><dt>Location</dt><dd>{profile.location}</dd></div>
      <div><dt>Experience</dt><dd>{profile.yearsExperience}</dd></div>
      <div><dt>Availability</dt><dd>{profile.availability}</dd></div>
      <div><dt>Primary focus</dt><dd>{profile.primaryFocus}</dd></div>
      <div><dt>Working style</dt><dd>{profile.workingStyle}</dd></div>
    </dl>
    <a class="link-arrow" href={profile.cvUrl} download>Download CV</a>
  </div>
</div>

<section class="education-archive" aria-labelledby="education-heading">
  <header class="education-heading">
    <p class="eyebrow">Academic Record</p>
    <h3 id="education-heading">Education</h3>
  </header>

  <ol>
    {[...education].sort((a, b) => a.order - b.order).map((item) => (
      <li class="education-entry">
        <p class="education-period">{item.startYear}—{item.endYear}</p>
        <div>
          <h4>{item.qualification}</h4>
          <p class="education-institution">{item.institution}</p>
        </div>
        <div class="education-meta">
          <p>{item.location}</p>
          {item.detail && <p>{item.detail}</p>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  figure { max-width: 22rem; border: 1px solid var(--color-rule); }
  figure img { aspect-ratio: 4 / 5; filter: grayscale(1); object-fit: cover; }
  figcaption { padding: 0.6rem; border-top: 1px solid var(--color-rule); font-size: 0.65rem; text-transform: uppercase; }
  .about-copy { display: grid; align-content: start; gap: 1.5rem; }
  .about-statement { font-family: var(--font-display); font-size: clamp(2.2rem, 4vw, 4.7rem); line-height: 0.98; text-transform: uppercase; }
  dl { display: grid; border-top: 1px solid var(--color-rule); }
  dl div { display: grid; grid-template-columns: minmax(7rem, 0.6fr) 1.4fr; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid var(--color-rule); }
  dt { color: var(--color-ink-muted); font-size: 0.68rem; text-transform: uppercase; }
  dd { font-size: 0.78rem; }
  .education-archive { border-top: 1px solid var(--color-rule); }
  .education-heading { display: grid; gap: 0.6rem; padding: 1.5rem 0; }
  .education-heading h3 { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; text-transform: uppercase; }
  .education-archive ol { border-bottom: 1px solid var(--color-rule); list-style: none; }
  .education-entry { display: grid; gap: 0.75rem; padding: 1.5rem 0; border-top: 1px solid var(--color-rule); }
  .education-period,
  .education-institution,
  .education-meta { font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .education-entry h4 { max-width: 42rem; font-family: var(--font-display); font-size: clamp(1.35rem, 2.4vw, 2.15rem); font-weight: 400; line-height: 1.08; text-transform: uppercase; }
  .education-institution { margin-top: 0.6rem; color: var(--color-ink-muted); line-height: 1.5; }
  .education-meta { display: grid; align-content: start; gap: 0.35rem; color: var(--color-ink-muted); }

  @media (min-width: 48rem) {
    .about-grid { grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.5fr); }
    .education-entry { grid-template-columns: minmax(7rem, 0.45fr) minmax(0, 1.55fr) minmax(8rem, 0.5fr); gap: 1.5rem; align-items: start; }
  }
</style>
